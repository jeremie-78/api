{
	"compilerOptions": {
		"target": "esnext",
		"module": "commonjs",
		"moduleResolution": "bundler",
		"rootDir": "./src",
		"outDir": "./dist",
		"strict": true,
		"skipLibCheck": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"types": [
			"node"
		]
		// "esModuleInterop": true,
		// "allowSyntheticDefaultImports": true
	},
	"include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}